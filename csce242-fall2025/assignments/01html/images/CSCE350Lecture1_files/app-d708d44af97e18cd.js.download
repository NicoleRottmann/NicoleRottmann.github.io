  <caption role="alert" class="sr-only">{{ ::config().title }}</caption>
  <thead>
    <tr class="table-headings">
      <th class="table-heading"
          scope="col"
          ng-style="{ 'width': column.widthPercentage, 'min-width': column.widthPercentage }"
          ng-repeat="column in config().columns"
          ng-if="column.visible"
          data-heading-index="{{ ::$index }}"
          ng-class="{
            'sortable-header': column.sort,
            'ascending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc',
            'descending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc'}"
          ng-attr-aria-sort="{{ $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc' ? 'ascending' :
          $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc' ? 'descending' : undefined }}">
        <button class="button-anchor" ng-if="column.sort" analytics-id="components.directives.table.sort.button">
          <span class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
          <i class="sort-control">
            <i class="arrow up" ></i>
            <i class="arrow down"></i>
          </i>
        </button>
        <span ng-if="!column.sort" class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
      </th>
    </tr>
  </thead>
  <tbody ng-if="table.initialDataLoaded || config().showRowsDuringRefresh">
    <tr ng-repeat="item in tableData()"
        class="table-row"
        ng-class="{'clickable': config().rowClickFn }"
        ng-click="config().rowClickFn ? config().rowClickFn(item): null"
        ng-transclude
        analytics-id="components.directives.table.rowClick"></tr>
  </tbody>
</table>
<div ng-if="config().pageSize && table.initialDataLoaded">
  <div bb-infinite-scroll="table.showMore()"
       infinite-scroll-immediate-check="false"
       infinite-scroll-total-count="config().totalCount"
       infinite-scroll-current-count="tableData().length"
       infinite-scroll-load-limit="config().pageSize"
       infinite-scroll-container="config().infiniteScrollContainerSelector()"
       infinite-scroll-tray-id="{{::config().instanceId}}-scroll-tray"></div>
</div>
<div class="spinner bb-secondary-color-2" ng-show="!table.initialDataLoaded"></div>`},142072:(e,t,a)=>{"use strict";a.d(t,{A:()=>r});var n=a(623162),s=a(570733);let r="ultra.components.directives.bbUiIcon.large.Survey";(0,n.z)(s.B,r,"bbUiIconLargeSurvey")},143432:(e,t,a)=>{"use strict";a.d(t,{q:()=>r});var n=a(267796),s=a(601478);let r=e=>(0,s.l)(t=>e.membershipId?n.Ltv.group.getGroupsByCourseIdContentIds(t,{courseId:e.courseId,contentIds:e.contentIds,membershipId:e.membershipId}):void 0)},145524:(e,t,a)=>{"use strict";a.d(t,{V:()=>o});var n=a(514041),s=a(267796),r=a(379850),i=a(910685);let o=(e,t)=>{let a=(0,i.Y)(),o=(0,r.D)(e,t);return(0,n.useEffect)(()=>{0!==Object.keys(t).length&&a(s.o1I.gradebookAttempt.loadByGradeIds({courseId:e,gradeIdColumnIdMap:t}))},[a,e,t]),o}},145710:(e,t,a)=>{"use strict";a.d(t,{s:()=>o});var n=a(910685),s=a(514041),r=a(267796),i=a(901403);let o=(e,t,a=!0)=>{let o=(0,n.Y)(),l=(0,i.a)(t),c=!0;return l&&t&&(c=t.some(e=>!l[e])),(0,s.useEffect)(()=>{a&&e&&t&&t.length>0&&(!l||c)&&o(r.o1I.gradebookColumn.loadGradebookColumns({courseId:e,columnIds:t}))},[o,e,t,l,a,c]),{gradebookColumns:l,allColumnsLoaded:!c}}},149411:(e,t,a)=>{"use strict";a.d(t,{A:()=>n});let n=a(267796)._hB},149510:(e,t,a)=>{"use strict";a.d(t,{C:()=>l});var n=a(267796),s=a(514041),r=a(910685),i=a(403953),o=a(473977);let l=(e,t,a)=>{let l=(0,r.Y)(),c=(0,i.o)(a),d=(0,o.v)({courseId:e,assessmentId:t,questionId:a});return(0,s.useEffect)(()=>{a&&(c&&!d||c&&(null==d?void 0:d.isValid)||!e||!t||!a||(null==d?void 0:d.isLoading)||l(n.o1I.question.loadQuestionById({courseId:e,assessmentId:t,questionId:a})))},[t,e,l,c,a,d,null==d?void 0:d.isLoading,null==d?void 0:d.isValid]),c}},150027:(e,t,a)=>{"use strict";a.d(t,{p:()=>i});var n=a(267796),s=a(514041),r=a(910685);let i=()=>{let e=(0,r.Y)();return(0,s.useCallback)(t=>{let{courseId:a,columnId:s,userId:r,payload:i}=t;a&&s&&r&&e(n.o1I.gradebookGrade.createGradeByUserId({...i,courseId:a,columnId:s,userId:r}))},[e])}},150204:(e,t,a)=>{"use 