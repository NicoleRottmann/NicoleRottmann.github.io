     bb-load-bundle="components/directives/conversion-status-bar" role="banner">
  <div class="conversion-prompt-container">
    <div class="conversion-prompt-title" bb-translate="course.conversion.statusBar.useUltraPromptTitle" course-org-token-resolver>
    </div>
    <div class="conversion-prompt-details" bb-translate="course.conversion.statusBar.useUltraPromptDetails" course-org-token-resolver>
    </div>
    <a class="hide-for-medium-only hide-for-small-only"
        bb-translate="course.conversion.statusBar.moreInfoLink" bb-translate-attrs="{ 'href': 'course.conversion.statusBar.moreInfoLinkUrl' }"
        target="_blank" rel="noopener noreferrer"
        analytics-id="course.conversion.statusBar.moreInfoLink"></a>
  </div>
  <div class="conversion-button-container">
    <a href="javascript:void(0);" class="js-back-to-classic conversion-button conversion-return-classic show-for-large-up"
        ng-click="conversionStatusBarController.backToClassic()" component-key="conversionBackToClassic"
        analytics-id="course.conversion.statusBar.backToClassic">
      <bb-translate course-org-token-resolver>course.conversion.statusBar.backToClassic</bb-translate>
    </a>
    <button class="js-back-to-classic conversion-button conversion-return-button button button--secondary"
        ng-click="conversionStatusBarController.backToClassic()" component-key="conversionBackToClassic"
        analytics-id="course.conversion.statusBar.backToClassic.button">
      <span bb-translate="course.conversion.statusBar.backToClassic" course-org-token-resolver></span>
    </button>
    <button class="js-use-new-ux conversion-button button default" ng-click="conversionStatusBarController.useTheNewExperience()"
            bb-confirmation-needed="resource/x-bb-course-conversion" show-type="always"  confirmation-course-org-token-resolver
            analytics-id="course.conversion.statusBar.useUltra.button">
      <span bb-translate="course.conversion.statusBar.useUltra" course-org-token-resolver></span>
    </button>
  </div>
</div>
`},252442:e=>{e.exports=`<bb-modal id="disallow-folder-upload-modal" class="notification js-disallow-folder"
          modal-title-key="{{isChrome || hasFiles ? 'components.directives.fileUpload.disallowFolderUploadTitle' : 'components.directives.fileUpload.disallowFolderUploadNotChromeTitle'}}"
          analytics-id-tag-prefix="components.directives.fileUpload">
  <div name="modal-contents">
    <ng-switch on="isChrome">
      <div ng-switch-when="true">
        <p>
          <bb-translate>components.directives.fileUpload.disallowFolderUploadFull</bb-translate>
        </p>
      </div>
      <div ng-switch-default>
        <ng-switch on="hasFiles">
          <div ng-switch-when="true">
            <p>
              <bb-translate>components.directives.fileUpload.disallowFolderUploadFullNotChromeAdditionalFiles</bb-translate>
            </p>
          </div>
          <div ng-switch-default>
            <p>
              <bb-translate>components.directives.fileUpload.disallowFolderUploadFullNotChromeNoMoreFiles</bb-translate>
            </p>
          </div>
        </ng-switch>
      </div>
    </ng-switch>
  </div>
  <div name="modal-footer" class="reveal-modal__footer-content reveal-modal__footer-content--gray" ng-switch on="isChrome || hasFiles">
    <div class="reveal-modal__footer-buttons">
      <span class="reveal-modal__footer-button-container" ng-switch-when="true">
        <button class="button button--secondary js-secondary-button" ng-click="fileUpload.modalCancelUpload()" analytics-id="components.directives.fileUpload.no">
          <bb-translate>components.directives.fileUpload.no</bb-translate>
        </button>
      </span>
      <span class="reveal-modal__footer-button-container" ng-switch-when="true">
        <button class="button js-primary-button" ng-click="fileUpload.closeModal()" analytics-id="components.directives.fileUpload.yes">
          <bb-translate>components.directives.fileUpload.yes</bb-translate>
        </button>
      </span>
      <span class="reveal-modal__footer-button-container" ng-switch-when="false">
        <button class="button js-primary-button" ng-click="fileUpload.modalCancelUpload()" analytics-id="components.directives.fileUpload.cancelUploadText">
          <bb-translate>components.directives.fileUpload.cancelUploadText</bb-translate>
        </button>
      </span>
    </div>
  </div>
</bb-modal>
