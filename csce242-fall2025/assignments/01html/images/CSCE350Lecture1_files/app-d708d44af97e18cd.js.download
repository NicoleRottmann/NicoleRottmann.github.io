        bb-translate-attrs="{'aria-label': 'components.directives.grade.grid.scoreInputAriaLabel'}"
        ng-blur="gradeGridCellEditorReborn.onInputBlur($event)"
        placeholder="--" ng-model="gradeGridCellEditorReborn.score"
        ng-click="gradeGridCellEditorReborn.stopPropagation($event)"
        ng-change="gradeGridCellEditorReborn.onChange()"
        aria-describedby="totalPoints"
        ng-keydown="gradeGridCellEditorReborn.onKeydown($event)" spellcheck="false" autocomplete="off"
        analytics-id="components.directives.grade.gradeGridCellEditorReborn.input.text" />
