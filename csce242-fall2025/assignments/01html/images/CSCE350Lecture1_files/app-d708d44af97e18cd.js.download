  <ul class="f-dropdown f-dropdown-overflow-menu reborn-dropdown cell-dropdown" role="menu">
    <li ng-if="cell.canBeView"
        role="presentation">
        <button role="menuitem"
                class="js-view-submission button clear"
                ng-click="cell.view()"
                analytics-id="components.directives.grade.grid.viewItem">
          <bb-svg-icon size="small" icon="visible"></bb-svg-icon>
          <bb-translate  class="ellipse">components.directives.grade.grid.viewItem</bb-translate>
        </button>
    </li>
    <li ng-if="cell.viewFeedback"
        role="presentation">
      <button role="menuitem"
              class="js-add-feedback button clear"
              ng-click="cell.openGradeAndFeedbackPanel()"
              analytics-id="components.directives.grade.grid.feedback">
        <bb-svg-icon size="small" icon="add-feedback"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.feedback</bb-translate>
      </button>
    </li>
    <li ng-class="{disable: !isReadyToPost()}"
        ng-if="cell.canPost()"
        role="presentation">
        <button role="menuitem"
                class="js-post-grade button clear"
                ng-click="post()"
                ng-disabled="!isReadyToPost()"
                analytics-id="components.directives.grade.grid.post">
          <bb-svg-icon size="small" icon="post"></bb-svg-icon>
          <bb-translate class="ellipse" bb-translate>components.directives.grade.grid.post</bb-translate>
        </button>
    </li>
    <li ng-if="cell.shouldAllowUserToAddExceptions()"
          role="presentation">
          <button role="menuitem"
                  class="exception-grade button clear"
                  ng-click="cell.openExceptionPanel()"
                  analytics-id="components.directives.grade.grid.exceptions">
            <bb-ui-icon-small-time-extra class="exception-small-icon"></bb-ui-icon-small-time-extra>
            <bb-translate class="ellipse">components.directives.grade.submission-list-row.per-assessment.exceptions</bb-translate>
          </button>
    </li>
    <div bb-feature-toggle="feature.gradebook.exempt.gradable.item" remove-from-dom="true">
      <li ng-if="cell.canExempt()"
          role="presentation">
          <button role="menuitem"
                  class="exempt-grade button clear"
                  ng-click="cell.exempt()"
                  analytics-id="components.directives.grade.grid.exempt">
            <bb-ui-icon-small-exempt class="exempt-small-icon"></bb-ui-icon-small-exempt>
            <bb-translate class="ellipse" bb-translate>components.directives.grade.course-grades-student.exemption.exemption</bb-translate>
          </button>
      </li>
    </div>
