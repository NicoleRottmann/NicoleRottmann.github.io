  <!-- Static -->
  <li ng-switch-when="static" role="presentation" class="base-navigation-button" ui-sref-active="active" ng-attr-aria-hidden="{{ ($ctrl.previewMode ? 'true' : 'false') }}">
    <div ng-if="$ctrl.link.disabled" class="base-navigation-button-content themed-background-primary-alt-fill-only disabled">
      <bb-svg-icon icon="{{::$ctrl.link.icon}}" size="medium" aria-hidden="true"></bb-svg-icon>
      <ng-switch on="$ctrl.link.id">
        <div class="ellipsis" ng-switch-when="profile">
          <bb-username class="link-text" user="$ctrl.user" auto-update="true"></bb-username>
        </div>
        <span ng-switch-default class="link-text" bb-translate>{{::$ctrl.link.titleKey}}</span>
      </ng-switch>
      <span class="round alert label" ng-show="counts[$ctrl.link.id]">{{counts[$ctrl.link.id]}}</span>
    </div>

    <a ng-if="!$ctrl.link.disabled" class="base-navigation-button-content themed-background-primary-alt-fill-only theme-border-left-active" ui-sref="{{ $ctrl.link.sref }}"
       bb-enter-key-up-focus=".base-skip-link .skip-link" bb-trigger-enter-keydown="true" ng-click="$ctrl.handleBaseLinkClick($event)"
       ng-attr-aria-label="{{ $ctrl.link.titleAriaLabel ? $ctrl.link.titleAriaLabel() : undefined }}"
       ng-attr-tabindex="{{ ($ctrl.previewMode ? '-1' : '') }}" analytics-id="{{ $ctrl.link.id }}.base.navigation.handleBase.link" aria-current="{{ $ctrl.isActive() }}">
      <ng-switch on="$ctrl.link.id">
        <div class="ellipsis" ng-switch-when="profile">
          <bb-svg-icon icon="{{::$ctrl.link.icon}}" size="medium" aria-hidden="true"></bb-svg-icon>
          <bb-username id="sidebar-user-name" class="link-text" user="$ctrl.user" auto-update="true"></bb-username>
        </div>
        <div ng-switch-when="messages">
          <bb-ui-icon-with-badge color="brandAlternative"
                                 icon="$ctrl.link.iconElement"
                                 position="corner-top-right"
                                 show-badge="$ctrl.link.showBadge()"
                                 badge-content="$ctrl.link.badgeContent()"
                                 custom-badge-class="base-navigation-button-badge"></bb-ui-icon-with-badge>
          <span class="link-text" bb-translate>{{::$ctrl.link.titleKey}}</span>
        </div>
        <div ng-switch-default>
          <bb-svg-icon icon="{{::$ctrl.link.icon}}" size="medium" aria-hidden="true"></bb-svg-icon>
          <span class="link-text" bb-translate>{{::$ctrl.link.titleKey}}</span>
        </div>
      </ng-switch>
      <span class="round alert label" ng-show="counts[$ctrl.link.id]">{{counts[$ctrl.link.id]}}</span>
    </a>
  </li>

  <!-- Integration -->
  <li ng-switch-when="uef" role="presentation" class="base-navigation-button" ng-attr-aria-hidden="{{ ($ctrl.previewMode ? 'true' : 'false') }}" ng-class="{'active': $ctrl.isIntegrationRouteActive()}" aria-current="{{ $ctrl.isActive() }}">
    <div class="themed-background-primary-alt-fill-only integration-navigation-button-content">
      <bb-portal-host
        selector="base.navigation.button"
        selector-data="{ route: $ctrl.link.routeName }"
        initial-owning-integration-id="$ctrl.link.owningIntegrationId"
        initial-content="$ctrl.link.initialContent"
      ></bb-portal-host>
    </div>
  </li>
</div>
