  <div class="panel-block restricted-form content-visibility-rules-container">
    <div class="row collapse">
      <div class="columns small-12 js-from-checkbox">
        <input type="checkbox"
               ng-model="contentVisibilityRulesOptions.startDateSelect"
               class="from-check"
               id="from-check-{{contentVisibilityRulesOptions.id}}"
               name="fromCheck"
               ng-change="contentVisibilityRulesOptions.handleCheckClick('from-check')"
               ng-show="!isReadOnlyMode()"
               analytics-id="content.visibility.rules.options.startDateSelect.input.checkbox"/>
        <label class="date-time-label" for="from-check-{{contentVisibilityRulesOptions.id}}" ng-show="!isReadOnlyMode()"
          bb-translate>course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.checkboxLabel</label>
        <label class="date-time-label"
          ng-show="isReadOnlyMode() && (contentVisibilityRulesOptions.startDateSelect || isAllowedEmpty)"
          bb-translate>
          course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.checkboxLabel
        </label>
      </div>
      <div
        ng-show="contentVisibilityRulesOptions.startDateSelect || !isReadOnlyMode() || (isAllowedEmpty && isReadOnlyMode())"
        class="columns small-12">
        <div class="row collapse date-time-inputs" ng-class="{'read-only-fields': isReadOnlyMode()}">
          <div class="columns small-6 js-date-input-container {{contentVisibilityRulesOptions.dateFromContainer}}"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateFromDisabled}">
            <!-- htmlhint:analytics-id:disable -->
            <input id="date-from"
                   bb-date-picker
                   orientation="auto left"
                   container=".{{contentVisibilityRulesOptions.dateFromContainer}}"
                   ng-model="startDate" name="dateFrom" aria-describedby="date-from-error"
                   ng-model-options="{ allowInvalid: true }"
                   first-day-of-week="contentVisibilityRulesOptions.localeSettings.calendar.firstDayOfWeek"
                   bb-validate-date
                   ng-class="{'read-only-field': isReadOnlyMode()}"
                   ng-attr-bb-focus="contentVisibilityRulesOptions.shouldFocus('start-date')"
                   ng-blur="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-required="contentVisibilityRulesOptions.isDateRequired(true)"
                   ng-change="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-disabled="contentVisibilityRulesOptions.timeDateFromDisabled"
                   bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.dateAriaLabel',
                       'placeholder': 'components.directives.content-visibility.datePlaceholder'}"
                   analytics-id="content.visibility.rules.options.startDate.input.text"/>
              <!-- htmlhint:analytics-id:enable -->
          </div>
          <div class="columns small-6 input group"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateFromDisabled}">
            <bb-time-picker name="timeFrom"
                            id="time-from"
                            aria-describedby="time-from-error"
                            invalid-validation-key="time"
                            analytics-id="content.visibility.rules.options.startDate.input.text"
                            ng-model="startTime"
                            disabled="contentVisibilityRulesOptions.timeDateFromDisabled"
                            bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.timeAriaLabel',
                                'placeholder': 'components.directives.content-visibility.timePlaceholder'}"
            ></bb-time-picker>
          </div>
        </div>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12">
        <div bb-validation-messages for="dateFrom" class="row collapse" id="date-from-error">
            <span ng-message="required">
                <bb-translate>components.directives.content-visibility.startDateError</bb-translate>
              </span>
          <span ng-message="date" bb-translate>
            {{::contentVisibilityRulesOptions.setErrorString(true, true)}}
          </span>
          <span ng-message="startAndOrEndDate">
            <bb-translate>components.directives.content-visibility.startAndOrEndDateError</bb-translate>
          </span>
          <span ng-message="startAndOrEndDateOnsubmit">
            <bb-translate>components.directives.content-visibility.startAndOrEndDateError</bb-translate>
          </span>
          <span ng-message="startBeforeDueDate">
            <bb-translate>components.directives.content-visibility.dueDateBeforeError</bb-translate>
          </span>
          <span ng-transclude="customStartDateAndTimeValidationMessages"></span>
        </div>
      </div>
      <div bb-validation-messages for="timeFrom" class="row collapse" id="time-from-error">
          <span ng-message="required">
              <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessFrom</bb-translate>
          </span>
        <span ng-message="time">
            {{::contentVisibilityRulesOptions.setErrorString(false, true)}}
        </span>
        <span ng-message="required">
          <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessFrom</bb-translate>
        </span>
        <span ng-transclude="customStartDateAndTimeValidationMessages"></span>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12 js-until-checkbox">
        <input type="checkbox"
               ng-model="contentVisibilityRulesOptions.untilDateSelect"
               class="until-check"
               id="until-check-{{contentVisibilityRulesOptions.id}}"
               name="untilCheck"
               ng-change="contentVisibilityRulesOptions.handleCheckClick('until-check')"
               ng-show="!isReadOnlyMode()"
               analytics-id="content.visibility.rules.options.untilDate.input.checkbox"/>
        <label class="date-time-label" for="until-check-{{contentVisibilityRulesOptions.id}}"
          ng-show="!isReadOnlyMode()" bb-translate>course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.checkboxLabel</label>
        <label class="date-time-label"
          ng-show="isReadOnlyMode() && (contentVisibilityRulesOptions.untilDateSelect || isAllowedEmpty)" bb-translate>
          course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.checkboxLabel
        </label>
      </div>
      <div
        ng-show="contentVisibilityRulesOptions.untilDateSelect || !isReadOnlyMode() || (isAllowedEmpty && isReadOnlyMode())"
        class="columns small-12">
        <div class="row collapse date-time-inputs" ng-class="{'read-only-fields': isReadOnlyMode()}">
          <div class="columns small-6 js-date-input-container {{contentVisibilityRulesOptions.dateUntilContainer}}"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateUntilDisabled}">
            <!-- htmlhint:analytics-id:disable -->
            <input id="date-until"
                   bb-date-picker
                   orientation="auto left"
                   container=".{{contentVisibilityRulesOptions.dateUntilContainer}}"
                   ng-model="endDate"
                   ng-model-options="{ allowInvalid: true }"
                   first-day-of-week="contentVisibilityRulesOptions.localeSettings.calendar.firstDayOfWeek"
                   bb-validate-date
                   name="dateUntil"
                   aria-describedby="date-until-error" ng-class="{'read-only-field': isReadOnlyMode()}"
                   ng-attr-bb-focus="contentVisibilityRulesOptions.shouldFocus('end-date')"
                   ng-blur="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-change="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-required="contentVisibilityRulesOptions.isDateRequired(false)"
                   ng-disabled="contentVisibilityRulesOptions.timeDateUntilDisabled"
                   bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.dateAriaLabel',
                       'placeholder': 'components.directives.content-visibility.datePlaceholder'}"
                   analytics-id="content.visiblity.rules.options.endDate.input.input.text"/>
            <!-- htmlhint:analytics-id:enable -->
          </div>
          <div class="columns small-6 input group"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateUntilDisabled}">
            <bb-time-picker name="timeUntil"
                            id="time-until"
                            aria-describedby="time-until-error"
                            analytics-id="content.visibility.rules.options.endDate.input.text"
                            ng-model="endTime"
                            disabled="contentVisibilityRulesOptions.timeDateUntilDisabled"
                            invalid-validation-key="time"
                            bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.timeAriaLabel',
                                'placeholder': 'components.directives.content-visibility.timePlaceholder'}"
            ></bb-time-picker>
          </div>
        </div>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12">
        <div bb-validation-messages for="dateUntil" class="row collapse" id="date-until-error">
          <span ng-message="required">
            <bb-translate>components.directives.content-visibility.endDateError</bb-translate>
          </span>
          <span ng-message="date">
            {{::contentVisibilityRulesOptions.setErrorString(true, false)}}
          </span>
          <span ng-message="requiredOnsubmit">
            <bb-translate>components.directives.content-visibility.endDateError</bb-translate>
          </span>
          <span ng-message="untilAfterStart">
            <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.endDateOnOrBeforeStartDate</bb-translate>
          </span>
          <span ng-message="untilAfterStartOnsubmit">
            <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.endDateOnOrBeforeStartDate</bb-translate>
          </span>
          <span ng-message="untilDueDate">
            <bb-translate>components.directives.content-visibility.dueDateAfterError</bb-translate>
          </span>
          <span ng-message="subsequentDueDate">
            <bb-translate>components.directives.content-visibility.subsequentDueDateAfterError</bb-translate>
          </span>
          <span ng-transclude="customEndDateAndTimeValidationMessages"></span>
        </div>
      </div>
      <div bb-validation-messages for="timeUntil" class="row collapse" id="time-until-error">
        <span ng-message="time">
           {{::contentVisibilityRulesOptions.setErrorString(false, false)}}
        </span>
        <span ng-message="required">
          <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessUntil</bb-translate>
        </span>
        <span ng-transclude="customEndDateAndTimeValidationMessages"></span>
      </div>
    </div>
  </div>
</div>
