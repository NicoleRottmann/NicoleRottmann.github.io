          ng-class="{hide: !(addContentButton.isButtonVisible || addContentButton.alwaysShow || addContentButton.isMenuVisible)}"
          aria-expanded="{{addContentButton.isMenuVisible}}"
          aria-controls="{{::'add-content-menu-' + addMenuId}}"
          aria-label="{{addContentButton.addButtonAriaLabel}}"
          ng-focus="addContentButton.showButton()"
          ng-blur="addContentButton.hideButton()"
          analytics-id="components.directives.add-content-button.attempts.button">
  </button>
  <!-- use ng-show to keep the element when close add buttons, make sure the upload directive handlers will not be lost -->
  <ul role="menu" class="element-list-add-menu outline-menu angular-animate"
      aria-expanded="{{addContentButton.isMenuVisible}}"
      ng-attr-id="{{::'add-content-menu-' + addMenuId}}"
      ng-if="::addContentButton.isMenuVisible || undefined"
      ng-show="addContentButton.isMenuVisible">
    <li>
      <bb-file-upload
        url="/v1/files"
        data="{}"
        monitor-leave="true"
        allow-multiple="true"
        target-div="{{'#' + fileListViewId}}"
        disable-drag="disableDrag && disableDrag()"
        hide-transclude-during-upload="false"  is-third-party-upload="false"
        third-party-download-handler="addContentButton.downloadFile"
        skip-zip-file-check="true">
        <div class="columns medium-12" ng-class="{'medium-center': attempt.isMobile}">
          <a href="javascript:void(0);"
             role="menuitem"
             bb-translate-attrs="{'aria-label':'course.content.buildContentArea.addFiles'}"
             ng-click="addContentButton.toggleMenu()"
             analytics-id="components.directives.add-content-button.attempts.fileUpload.link">
            <bb-svg-icon size="small" icon="upload"></bb-svg-icon>
            <span bb-translate>course.content.fileUpload.addFiles</span>
          </a>
        </div>
      </bb-file-upload>
    </li>
  </ul>
</div>
