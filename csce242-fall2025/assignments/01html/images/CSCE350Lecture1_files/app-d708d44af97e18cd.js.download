  <footer class="panel-footer" ng-if="!(hideCancel() || hideSave() || hideDelete())">
    <!--footer tag is removed, and its children appended to parent if the directive is marked as 'isInline'-->
    <div ng-class="{'inline':isInline(), 'panel-footer-right':!isInline()}" class="buttons-2 equal-buttons">
      <button ng-if="!(hideDelete() != null ? hideDelete() : true)"
              class="button js-delete js-primary-button non-first-focus" ng-class="{'small clear icon':isInline}"
              bb-confirmation-needed="{{ deleteConfirmationResourceType }}"
              show-type="{{mustShowDeleteConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isDeleteDisabled()"
              ng-click="saveButtons.deleteAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="button"
              choices="{{choices()}}"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.delete.button">
                <span ng-if="!isInline()">{{saveButtons.deleteButtonStatus}}</span>
                <span ng-if="isInline()"><i class="icon-trash"></i></span>
      </button>
      <button ng-if="!hideCancel()"
              class="button button--secondary js-cancel js-secondary-button non-first-focus"
              bb-confirmation-needed="{{ saveButtons.isCancelNowADelete() ? deleteConfirmationResourceType : '' }}"
              show-type="{{mustShowDeleteConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isCancelDisabled()"
              ng-click="saveButtons.cancelAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="button"
              choices="{{choices}}"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.cancel.button">{{saveButtons.cancelButtonStatus}}</button>
      <button ng-if="!hideSave()"
              class="button js-save js-primary-button non-first-focus"
              bb-confirmation-needed="{{ saveConfirmationResourceType }}"
              show-type="{{mustShowSaveConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isSaveDisabled()"
              ng-click="saveButtons.saveAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="submit"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.save.button">{{saveButtons.saveButtonStatus}}</button>
    </div>
  </footer>
</div>`},899807:(e,t,a)=>{"use strict";a.d(t,{l:()=>o});var n=a(514041),s=a(267796),r=a(910685),i=a(601478);let o=e=>{let t=(0,r.Y)();return(0,n.useEffect)(()=>{e&&t(s.o1I.user.loadUser(e))},[t,e]),(0,i.l)(t=>s.Ltv.user.getUserById(t,e))}},900387:(e,t,a)=>{"use strict";a.d(t,{IA:()=>x,KF:()=>P,Lr:()=>T,YT:()=>D,ag:()=>_,y_:()=>N});var n=a(224236),s=a(640103),r=a(837677),i=a(651145),o=a(770543),l=a(91025),c=a(821077),d=a(869775),u=a(953034),p=a(883701),m=a(549077),h=a(77232),g=a(11377),b=a(773925),v=a(314245),f=a(216669),y=a(208069),E=a(169861),C=a(267796),S=a(241004),k=a(104230),I=a(450389),w=a(163785);function A(e,t){return function(a,n){t(a,n,e)}}let x="ultra.features.course.grades.gradesSettings.controller",N="update-telemetry-settings",T="bb-update-grade-settings-overall-grade",_="refresh-after-update-settings",P="refresh-after-hide-unavailable-students";class D{static #e=this.STUDENT_FAILING_PREFERENCE_KEY="telem.threshold.failing.grade";static #t=this.STUDENT_ABSENT_PREFERENCE_KEY="telem.threshold.days.absent";static #a=this.STUDENT_MISSED_DUE_DATE_PREFERENCE_KEY="telem.threshold.missed.due.dates";static #n=this.STUDENT_ALERTS_ENABLED="telem.student.alerts.enabled";static #s=this.STUDENT_ABSENT_DEFAULT=15;static #r=this.INITIAL_FAILING_PREF_ARGS={key:D.STUDENT_FAILING_PREFERENCE_KEY};static #i=this.INITIAL_ABSENT_PREF_ARGS={key:D.STUDENT_ABSENT_PREFERENCE_KEY};static #o=this.INITIAL_MISSED_DUE_DATE_PREF_ARGS={key:D.STUDENT_MISSED_DUE_DATE_PREFERENCE_KEY};static #c=this.INITIAL_ENABLE_PREF_ARGS={key:D.STUDENT_ALERTS_ENABLED,defaultValue:"true"};static #d=this.uid=0;constructor(e,t,a,s,o,l,c,d,u,p,m,h,g,b,v,f){var y=this;this.$scope=e,this.$rootScope=t,this.$q=a,this.course=s,this.$modal=o,this.localizeService=l,this.timeout=c,this.GradeNotationModel=d,this.ultraState=u,this.schemaService=p,this.categoryService=m,this.gradebookPermissionService=h,this.entitlementService=g,this.context=b,this.grade=v,this.featureFlagService=f,this.isShowSettingPage=!0,this.isSche