          modal-title-key="course.content.ltiNeedsApprovalTitle"
          analytics-id-tag-prefix="course.content.ltiNeedsApproval">
  <div name="modal-contents">
    <p ng-if="hasEmail" bb-translate>course.content.ltiNeedsApprovalDescription</p>
    <p ng-if="hasEmail"><a href="mailto:{{ ::email }}" analytics-id="components.services.lti.needsApproval.email.link">{{ ::email }}</a></p>
