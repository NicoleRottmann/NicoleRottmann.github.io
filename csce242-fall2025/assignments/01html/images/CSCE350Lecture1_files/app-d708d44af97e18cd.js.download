  <ul class="f-dropdown f-dropdown-overflow-menu reborn-dropdown" role="menu">
    <li role="presentation" ng-if="col.canShowReminderOption() && col.canModifyGradebook">
      <!-- class="react-component-menu-item" for pointing out that the child is react-component -->
      <a role="menuitem"
         href="javascript:void(0);"
         class="react-component-menu-item"
         analytics-id="course.grades.gradebook.sendReminders.link">
        <send-reminders-menu-item
          analytics-id="::course.grades.gradebook.sendReminders"
          course-id="::col.data.courseId"
          column-id="col.data.id"
          is-group="col.data.groupContent"
          num-students-not-submitted="col.getStudentsNoSubmissionCount()">
        </send-reminders-menu-item>
      </a>
    </li>
    <li ng-if="col.isScorm()" role="presentation">
      <a role="menuitem"
         ng-click="col.previewScorm()"
         href="javascript:void(0);"
         analytics-id="components.directives.grade.grid.viewScorm">
        <bb-svg-icon size="small" icon="visible"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.viewScorm</bb-translate>
      </a>
    </li>
    <li ng-if="col.data.ultraTextColumn" role="presentation">
      <a role="menuitem"
          bb-peek-sref="submission-text-item({ columnId: col.id })"
          analytics-id="gradebook.textItemSubmission.viewTextItem">
        <bb-svg-icon size="small" icon="visible"></bb-svg-icon>
        <bb-translate class="ellipse">gradebook.textItemSubmission.viewTextItem</bb-translate>
      </a>
    </li>
    <li ng-if="col.canView() && !col.canEdit() && !col.isScorm()" role="presentation">
      <a role="menuitem"
          ng-click="col.viewOrEdit()"
          href="javascript:void(0);"
          analytics-id="components.directives.grade.grid.viewItem">
        <bb-svg-icon size="small" icon="visible"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.viewItem</bb-translate>
      </a>
    </li>
    <li ng-if="col.canEdit()" role="presentation">
      <a  role="menuitem"
          class="js-edit-column"
          ng-click="col.viewOrEdit()"
          href="javascript:void(0);"
          analytics-id="components.directives.grade.grid.edit">
        <bb-svg-icon size="small" icon="draw"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.edit</bb-translate>
      </a>
    </li>
    <li ng-if="canPostGrades" role="presentation">
      <a  role="menuitem"
          class="js-post-column"
          ng-click="col.postGrades()"
          href="javascript:void(0);"
          bb-confirmation-needed="{{grade.getPostAllGradeConfirmationNeededStringsKey(col.data)}}"
          modal-aria-type="alertdialog"
          show-type="always"
          analytics-id="components.directives.grade.grid.postAllGrades">
        <bb-svg-icon size="small" icon="post"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.post</bb-translate>
      </a>
    </li>
    <li ng-if="col.data.isQuestionAnalysisAvailable() && col.canViewQuestionAnalysis()"
        remove-from-dom="true"
        role="presentation">
      <a  role="menuitem"
          class="js-open-question-analysis"
          ng-click="col.openQuestionAnalysisOverview()"
          href="javascript:void(0);"
          analytics-id="components.directives.grade.grid.openQuestionAnalysis">
        <bb-svg-icon size="small" icon="question-analysis"></bb-svg-icon>
        <bb-translate class="ellipse">components.directives.grade.grid.openQuestionAnalysis</bb-translate>
      </a>
    </li>
    <li ng-if="col.showDownloadResults()" role="presentation">
      <a role="menuitem"
          class="js-download-results"
          ng-click="col.openDownloadTestResultsPanel()"
          href="javascript:void(0)"
          analytics-id="components.directives.grade.grid.downloadResults">
        <bb-ui-icon-small-download></bb-ui-icon-small-download>
        <bb-translate class="ellipse">components.directives.grade.grader-column.downloadResults.overflowMenuLabel</bb-translate>
      </a>
    </li>
    <li ng-if="col.hasDownloads() && col.canDownloadAll()" role="presentation">
      <a role="menuitem"
          class="js-download-all"
          ng-click="col.openDownloadAll()"
          href="javascript:void(0)"
          analytics-id="components.directives.grade.grid.downloadAll">
        <bb-ui-icon-small-download-file></bb-ui-icon-small-download-file>
        <bb-translate class="ellipse">components.directives.grade.grid.downloadSubmissions</bb-translate>
      </a>
    </li>
    <li ng-if="col.shouldShowStatistics()" role="presentation">
      <a role="menuitem"
          class="js-column-statistics"
          ng-click="col.openColumnStatisticsPanel()"
          href="javascript:void(0)"
          analytics-id="components.directives.grade.grid.column-statistics.link">
        <bb-ui-icon-small-report></bb-ui-icon-small-report>
        <bb-translate class="ellipse">components.directives.grade.grid.statisticsMenuLabel</bb-translate>
      </a>
    </li>
    <li ng-if="col.canDelete()" role="presentation">
      <a class="js-delete-column"
         href="javascript:void(0);"
         ng-click="col.triggerDelete($event)"
         ng-switch="!!col.data.contentId"
         analytics-id="components.directives.grade.grid.deleteColumn.link"
         role="button">
        <!-- Content column -->
        <bb-delete callback-function="col.deleteColumn()"
                   class="ellipse"
                   content-id="col.data.contentId"
                   course-id="col.data.courseId"
                   display-mode="controls"
                   ng-switch-when="true"
                   role="menuitem">
        </bb-delete>
        <!-- Grading column -->
        <bb-delete class="ellipse"
                   confirmation-handler="{{col.getConfirmationMessage()}}"
                   delete-function="col.deleteColumn()"
                   display-mode="controls"
                   ng-switch-when="false"
                   role="menuitem">
        </bb-delete>
      </a>
    </li>
