        bb-translate translate-values="infiniteScroll.loadMoreLocalizationValues"
        analytics-id="{{::infiniteScroll.localizationKeysPrefix + '.loadMoreButton.label.plural'}}">{{::infiniteScroll.localizationKeysPrefix + '.loadMoreButton.label.plural'}}</button>
