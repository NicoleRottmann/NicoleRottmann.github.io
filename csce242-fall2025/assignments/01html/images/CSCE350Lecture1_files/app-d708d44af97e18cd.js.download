  <div class="rb-grid-header-wrapper">
    <div class="rb-grid-header">
      <div class="rb-grid-canvas" ng-style="container.getHeaderCanvasStyle()" role="rowgroup">
        <div class="rb-row rb-header-row" ng-class="::container && {'rb-row-border': container.headerBorder} || undefined" role="row">
          <div rb-grid-cell="col.headerTemplate"
               class="rb-cell rb-header-cell"
               ng-class="['rb-col-' + col.id, 'rb-column-position-' + col.id, {'rb-cell-border': col.border}]"
               role="columnheader"
               ng-repeat="col in container.renderedColumns track by col.id"
               ng-click="container.callbacks.header($event)"
               analytics-id="components.directives.gridContainer.header.{{::col.id}}.button">
            <div class="rb-add-column-placeholder" ng-if="::container.canAddColumn()" ng-mouseenter="container.columnAdder.enter($event, col)"></div>
          </div>
          <div class="rb-add-column-placeholder first" ng-if="::container.canAddColumn()" ng-mouseenter="container.columnAdder.enter($event)"></div>
        </div>
      </div>
    </div>
    <div ng-if="container.hasVScrollbar" class="rb-grid-scrollbar-placeholder-y"></div>
  </div>
  <div class="rb-grid-body" ng-style="container.getBodyStyle()">
    <div class="rb-grid-canvas" ng-style="container.getBodyCanvasStyle()" role="rowgroup">
      <div class="rb-row rb-cell-row" ng-repeat="row in container.renderedRows track by $index" role="row"
          ng-class="['rb-row-position-' + row.id, container && {'rb-row-border': container.rowBorder} || undefined]">
        <div rb-grid-cell="col.cellTemplate"
             class="rb-cell"
             ng-class="['rb-col-' + col.id, 'rb-row-' + row.id, 'rb-column-position-' + col.id, {'rb-cell-border': col.border}]"
             ng-repeat="col in container.renderedColumns track by $index"
             ng-click="container.callbacks.cell($event)"
             analytics-id="components.directives.gridContainer.callback"
        ></div>
      </div>
    </div>
  </div>
  <div ng-if="!container.hasHScrollbar" class="rb-grid-scrollbar-placeholder-x"></div>
  <div class="rb-add-column" ng-if="::container && container.canAddColumn()">
    <div class="column-header-button-wrapper" ng-mouseleave="container.columnAdder.leave()">
      <a class="small button clear icon button-add-content hide"
         href="javascript:void(0);"
         ng-click="container.columnAdder.onClick($event)"
         role="button"
         aria-haspopup="true"
         analytics-id="components.directives.grade.grid.addBtuAriaLabel.link">
        <span class="sr-only" bb-translate>components.directives.grade.grid.addBtuAriaLabel</span>
      </a>
    </div>
  </div>
</div>
