  <button
    class="button-add-content js-show-add-options"
    aria-expanded="{{addContentButton.isMenuVisible}}"
    ng-class="{hide: !(addContentButton.isButtonVisible || addContentButton.alwaysShow || addContentButton.isMenuVisible)}"
    aria-label="{{addContentButton.addButtonAriaLabel}}"
    ng-focus="addContentButton.showButton()"
    ng-blur="addContentButton.hideButton()"
    id="{{::addContentButton.getTargetId()}}"
    ng-click="addContentButton.toggleAddContentMenu()"
    analytics-id="components.directives.add-content-button.editor.button">
  </button>
</div>
<bb-ui-contextual-menu
  items="::addContentButton.items"
  target-id="::addContentButton.getTargetId()"
  show="addContentButton.isMenuVisible"
  directional-hint="::addContentButton.getDirectionalHint()"
  dismiss="addContentButton.hideAddContentMenu"
  analytics-id="components.directives.add-content-button.contextualMenu"
>
</bb-ui-contextual-menu>
<!--
  The elements are kept around to trigger download actions.
  The 'ng-hide' class is added to prevent the buttons from interfering with AX (tab order, screen readers)
-->
<ul class="element-list-add-menu angular-animate ng-hide">
  <li>
    <button type="button"
            class="js-add-text-block"
            ng-click="addContentButton.addTextBlock()"
            analytics-id="components.directives.add-content-button.editor.addText.button">
      <div>
        <i class="icon-doc-pencil-2"></i>
        <span bb-translate>components.directives.add-content-button.addContent</span>
      </div>
    </button>
  </li>
  <li ng-if="addContentButton.canEditUnsafeHtml">
    <button type="button"
            ng-click="addContentButton.addHtmlBlock()"
            analytics-id="components.directives.add-content-button.editor.addHtml.button">
      <div>
        <bb-svg-icon size="small" icon="code"></bb-svg-icon>
        <span bb-translate>components.directives.add-content-button.addHtml</span>
      </div>
    </button>
  </li>
  <li>
    <bb-file-upload
      url="/v1/files"
      data="{}"
      monitor-leave="true"
      allow-multiple="true"
      hide-transclude-during-upload="false"
      primary-key="primaryKey && primaryKey() ? primaryKey() : fileListViewLocalId"
      skip-zip-file-check="true"
      click-enabled="true"
      disable-drag="false"
      class="js-file-upload"
      web-location="{{webLocation}}"
      file-location="{{fileLocation}}"
      target-div="{{'#' + fileListViewId}}"
      disallow-folder-uploads="true"
      is-third-party-upload="false"
      ignored-states="::ignoredStates()">
        <button
          type="button"
          class="file-upload-button"
          ng-click="addContentButton.assignPosition()"
          aria-label="{{addContentButton.uploadAriaLabel}}"
          analytics-id="components.directives.add-content-button.editor.fileUpload.button">
          <div ng-if="!addContentButton.isMobile">
            <i class="icon-arrow-upload"></i>
            <span bb-translate>components.directives.add-content-button.uploadFromComputer</span>
          </div>
          <div ng-if="addContentButton.isMobile">
            <i class="icon-arrow-upload"></i>
            <span bb-translate>components.directives.add-content-button.uploadFromDevice</span>
          </div>
        </button>
    </bb-file-upload>
  </li>
  <li ng-if="addContentButton.isCloudServiceAvailable">
    <bb-file-upload
      allow-multiple="false"
      monitor-leave="true"
      target-div="{{'#' + fileListViewId}}"
      hide-transclude-during-upload="false"
      click-enabled="false"
      primary-key="primaryKey && primaryKey() ? primaryKey() : fileListViewLocalId"
      skip-zip-file-check="true"
      disable-drag="true"
      is-third-party-upload="true"
      third-party-download-handler="addContentButton.downloadFile"
      ignored-states="::ignoredStates()">
      <button
        type="button"
        class="js-upload-from-cloud-storage-integration"
        ng-click="addContentButton.assignPosition()"
        bb-cloud-storage-integration
        primary-key="primaryKey && primaryKey() ? primaryKey() : fileListViewLocalId"
        attach-handler="attachHandler || addContentButton.defaultAttachHandler"
        web-location="{{webLocation}}"
        file-location="{{fileLocation}}"
        allow-multiple="false"
        on-cancel-focus="!initialUpload ? addContentButton.focusAddButton : null"
        analytics-id="components.directives.add-content-button.editor.uploadFromCloudStorage.button">
          <div>
            <i class="icon-cloud"></i>
            <span bb-translate>components.directives.add-content-button.uploadFromCloudStorage</span>
          </div>
        </button>
    </bb-file-upload>
  </li>
  <li>
    <button type="button"
            class="js-browse-content-collection-block"
            ng-click="addContentButton.browseContentCollection()"
            analytics-id="components.directives.add-content-collection-button.editor.addText.button">
      <div>
        <span bb-translate>course.contentCollection.browseContentCollection</span>
      </div>
    </button>
  </li>
</ul>
