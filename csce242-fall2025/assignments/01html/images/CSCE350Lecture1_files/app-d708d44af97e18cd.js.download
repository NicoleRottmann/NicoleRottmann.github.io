  <div class="notification-container" ng-switch on="saveTray.status">
    <span class="progress-indicator"><div class="canvas" ng-class="{'success-state' : saveTray.status === 'success', 'error-state' : saveTray.status === 'error'}"></div></span>
    <span class="progress-status" ng-switch-default bb-translate>{{::saveTray.localizationKeysPrefix}}.loadingMoreItems</span>
    <span class="progress-status" ng-switch-when="success" bb-translate>{{::saveTray.localizationKeysPrefix}}.itemsLoaded</span>
    <span class="progress-status" ng-switch-when="error" bb-translate>{{::saveTray.localizationKeysPrefix}}.itemsFailedToLoad</span>
  </div>
</div>
`},134017:e=>{e.exports=`<div class="timestamp" bb-load-bundle="components/directives/duration" ng-cloak bb-cache-compilation="duration-directive">
  <div ng-if="!duration.needAgo()">
    <div class="js-split-datetime" ng-if="duration.separateDatetime()">
      <span class="date" ng-bind="duration.date"></span>
      <span class="time" ng-bind="duration.time"></span>
    </div>
    <bb-datetime ng-if="!duration.separateDatetime()" ng-class="{'date':duration.date}" value="date" format="Short"></bb-datetime>
  </div>
  <div ng-if="duration.needAgo()"
       class="js-duration-ago"
       bb-translate="components.directives.duration.agoText"
       translate-values="{durationDate: duration.date, durationTime: duration.time}"></div>
</div>`},134307:e=>{e.exports=`<div class="panel-header persistent-white-header mode-{{mode}} panel-header-directive"
  bb-load-bundle="components/directives/panel-header"
  ng-class="{'is-editable' : panelHeader.editMode,
   'has-slider': hasSlider(),
   'can-edit': canEdit,
   'has-controls': showConversations() || showDelete() || showParticipants() || showSettings(),
   'has-visibility-toggle': showVisibility(),
   'compressed': isUnlabeled()}">
  <div class="panel-titles-container">
    <div ng-if="showCourse() && !isUnlabeled()">
      <div class="panel-sub-title js-vr-remove-random">
        <span ng-if="::!panelHeaderTitleTranslateKey">{{panelHeader.panelHeaderTitle}}</span>
        <span ng-if="::panelHeaderTitleTranslateKey" bb-translate>{{::panelHeaderTitleTranslateKey}}</span>
      </div>
    </div>
    <div class="panel-title-texteditor">
      <div class="editable-title-container" ng-show="!panelHeader.editMode">
        <!-- ULTRA-13692 Since there's already an "Edit" button, we don't want keyboard users to be able to focus on the title to edit it,
             otherwise there would be two ways to edit the title, which is confusing. However, since this title has an event listener, it's
             announced as "clickable" by screenreaders, so let's hide it with aria-hidden and add another instance of the header just for
             screenreaders instead. -->
        <h1 class="sr-only" tabindex="-1" aria-hidden="true">{{panelTitle}}</h1>
        <h1 class="panel-title secondary-title" ng-click="panelHeader.onEditMode()"
            ng-keydown="panelHeader.titlePressKey($event)" bb-focus
            ng-blur="panelHeader.blurTitle($event)"
            ng-class="{'student' : !canEdit, 'is-hovered': panelHeader.isEditButtonHovering}" title="{{panelTitle}}"
            analytics-id="components.directives.content.panelHeader.secondaryTitle.header">
             <!-- When announcing the title to screen readers, include the heading as well -->
            <span class="sr-only">{{panelHeader.panelHeaderTitle}}</span>{{panelTitle}}
        </h1>
        <button ng-if="canEdit" class="button super-clear edit-title" type="button"
                ng-click="panelHeader.onEditMode()"
                ng-mouseover="panelHeader.onEditButtonMouseOver()"
                ng-mouseleave="panelHeader.onEditButtonMouseLeave()"
                aria-label="{{ panelHeader.getAriaLabel() }}"
                analytics-id="course.content.panelHeader.edit.button">
          <bb-svg-icon size="small" icon="draw" aria-hidden="true"></bb-svg-icon>
        </button>
        <button ng-if="showLockIcon"
          class="icon super-clear button"
          type="button"
          analytics-id="course.content.panelHeader.locked.button"
          bb-tooltip enhanced-tooltip="true" tooltip-position="bottom"
          tooltip-center-content="true" tooltip-enable-on-mouse-over-for-all-breakpoints="true"
          tooltip-enable-on-mouse-leave-for-all-breakpoints="true"
          bb-translate-attrs="{'title':'components.directives.header.managedByInstitution'}"
        >
          <bb-svg-icon size="small" icon="lock" aria-hidden="true"></bb-svg-icon>
        </button>
      </div>
      <div class="panel-title-input-container" ng-show="panelHeader.editMode" bb-click-outside="panelHeader.onBlurTitle()">
        <input
          name="panel-title"
          class="panel-header-title panel-title secondary-title"
          type="text"
          autocapitalize="off"
          ng-keydown="panelHeader.pressKey($event)"
          maxlength="{{maxLength}}"
          ng-model="panelTitle"
          ng-model-options="{ getterSetter: true }"
          ng-blur="panelHeader.onBlurTitle($event)"
          ng-change="panelHeader.onChangeTitle()"
          bb-translate-attrs="{'aria-label':'{{::panelHeader.panelTitleInputAriaLabelKey}}'}"
          bb-placeholder="{{::panelHeader.translatedPlaceholder}}"
          translate-attrs-values="{{::localizationAttrsValues}}"
          analytics-id="course.content.panelHeader.title.input.text"
          >
      </div>
    </div>
  </div>

  <div
    class="header-actions-menu button-group header-group"
    ng-class="panelHeader.getButtonGroupClass()">

    <ng-transclude ng-transclude-slot="panelHeaderActions"></ng-transclude>

    <div ng-if="showVisibility()"
         class="action-item item-visibility"
         ng-class="{'visibility-selector-disabled': !panelHeader.isVisibilitySelectorEnabled()}">

      <bb-content-visibility-selector ng-if="content" content="content"
                                      disabled="content.isEditable()"
                                      is-visibility-selector-enabled="panelHeader.isVisibilitySelectorEnabled()"
                                      onchange-func="panelHeader.onChangeVisibility()"
                                      open-panel-on-restricted="openPanelOnRestricted()"
                                      on-restricted-selected-func="panelHeader.onRestrictedSelected()"
                                      validation-func="panelHeader.validateVisibilityChange(visibility)"
                                      onblur-func="panelHeader.onBlurVisibility()"
                                      disable-restricted="disableRestricted()"
                                      has-medium-icon="false"></bb-content-visibility-selector>
    </div>

    <div class="ally-icons" ng-if="showAllyIcon() && panelHeader.canShowAlly">
      <div class="small-ally-icon">
        <bb-ally-show content-id="{{::content.id}}" show-alternative-formats-link="true" show-icon="true"
          class="ally-icon"></bb-ally-show>
      </div>
      <div class="medium-ally-icon">
        <bb-ally-show content-id="{{::content.id}}" show-alternative-formats-link="true" show-icon="true" icon-size="medium"
          class="ally-icon"></bb-ally-show>
      </div>
    </div>

    <div ng-if="showConversations() && content.ui.hasConversationAttached && content.attachedForumLink"
         class="action-item conversation"
         ui-sref-active="active">
      <button ng-click="panelHeader.gotoConversation()"
         bb-translate-attrs="{'aria-label':'components.directives.header.conversationAriaLabel', 'title':'components.directives.header.conversation'}"
         translate-attrs-values="{itemTitle: panelTitle}"
         class="button super-clear icon open-conversation"
         type="button"
         analytics-id="panel.header.conversation.visibility.button">
        <bb-svg-icon size="medium" icon="conversation"></bb-svg-icon>
      </button>
    </div>
    <div ng-if="showDelete()"
         class="action-item delete"
         ng-class="{'delete-button': showDelete() && showSettings()}"
         ui-sref-active="active">
      <ng-switch on="panelHeader.getDeleteDirectiveArgumentType()">
        <bb-delete ng-switch-when="ContentOnly" extra-class="standard-button" content="content" choices="choices" analytics-id="panel.header.content.only.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndDelete" extra-class="standard-button" content="content" delete-function="ondeleteFunc()" choices="choices" analytics-id="panel.header.content.delete.button.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndHandler" extra-class="standard-button" content="content" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.content.header.button.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndDeleteAndHandler" extra-class="standard-button" content="content" delete-function="ondeleteFunc()" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.content.delete.handler.button.switch"></bb-delete>
        <bb-delete ng-switch-when="DeleteAndHandler" extra-class="standard-button" delete-function="ondeleteFunc()" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.delete.handler.button.switch"></bb-delete>
      </ng-switch>
    </div>
    <div ng-if="showParticipants()"
         class="action-item participants"
         ui-sref-active="active">
      <!--TODO: need add real route here -->
      <a bb-peek-sref="discussion-participants"
         bb-translate-attrs="{'aria-label':'components.directives.header.participants'}"
         class="button super-clear icon"
         analytics-id="components.directives.discussion.participants.link">
        <bb-svg-icon ng-if="!content.isGroupContent" size="medium" icon="people"></bb-svg-icon>
        <bb-svg-icon ng-if="content.isGroupContent" size="medium" icon="groups"></bb-svg-icon>
      </a>
    </div>

    <div ng-if="showSettings() && !!settingsPeekRef"
         class="action-item settings"
         ui-sref-active="active">
      <a class="button super-clear icon assessment-settings-button"
         href="javascript:void(0);"
         ng-class="{'disabled': settingsDisabled()}"
         ng-click="panelHeader.openSettingsPanel()"
         bb-translate-attrs="{'aria-label':'{{settingsLabel}}'}"
         analytics-id="panel.header.open.settings.panel.link">
        <bb-svg-icon size="medium" icon="{{::panelHeader.getSettingsIcon()}}"></bb-svg-icon>
      </a>
    </div>
    <ng-transclude ng-transclude-slot="panelHeaderCustomIcons" />
  </div>
  <div class="graded-count-wrap" ng-if="showSubmissionsGrading()">
    <div class="graded-count-wrap-col col-numbers">
      <div class="graded-numbers"
      ng-if="showSubmissionsGrading() && summary.$resolved"
      bb-translate="components.directives.header.submissions-grading.gradedCount.numbers"
      translate-values="{gradedCount: summary.numStudentsGraded(), totalCount: summary.numEligibleToBeGraded}"
      >
      </div>
      <div class="filtered-numbers" ng-if="showSubmissionsGrading() && isFiltered" bb-translate="components.directives.header.submissions-grading.filteredCount.numbers"
      translate-values="{filteredCount}">
      </div>
    </div>
    <div class="graded-count-wrap-col">
      <p class="graded-label" ng-if="showSubmissionsGrading() && summary.$resolved" bb-translate="components.directives.header.submissions-grading.gradedCount.plural"></p>
      <p class="graded-label" ng-if="showSubmissionsGrading() && isFiltered" bb-translate="components.directives.header.submissions-grading.filteredCount.plural"></p>
    </div>
  </div>
</div>
