`},120857:e=>{e.exports=`<div ng-if="addContentButton.isCloudServiceAvailable">
  <bb-file-upload
    allow-multiple="true"
    monitor-leave="true"
    target-div="{{'#' + fileListViewId}}"
    hide-transclude-during-upload="false"
    click-enabled="false"
    primary-key="primaryKey && primaryKey() ? primaryKey() : fileListViewLocalId"
    skip-zip-file-check="true"
    disable-drag="true"
    is-third-party-upload="true"
    third-party-download-handler="addContentButton.downloadFile"
    ignored-states="::ignoredStates()">
    <button ng-click="addContentButton.assignPosition()"
            class="doc-add-media clear ng-scope"
            bb-cloud-storage-integration
            primary-key="primaryKey && primaryKey() ? primaryKey() : fileListViewLocalId"
            attach-handler="addContentButton.cloudUploadAttachHandler"
            web-location="{{webLocation}}"
            file-location="{{fileLocation}}"
            allow-multiple="true"
            on-files-selected="addContentButton.onFilesSelectedHandler"
            analytics-id="components.directives.add-content-button.cloud-upload.button">
      <div class="import-action-header">
        <i class="icon-cloud add-content-cloud-upload-icon"></i>
        <span bb-translate>components.directives.add-content-button.importContentFromCloudStorage.title</span>
        <div class="action-details" bb-translate="components.directives.add-content-button.importContentFromCloudStorage.description"></div>
      </div>
    </button>
  </bb-file-upload>
</div>
`},121221:e=>{e.exports=`<bb-modal id="notification-modal-api-error"
          class="notification"
          modal-title-key="components.services.error-modal.error-too-long.title"
          analytics-id-tag-prefix="components.services.error-modal.error-too-long">
  <div name="modal-contents">
    <p bb-translate>components.services.error-modal.error-too-long.description</p>
    <bb-session-debug-modal-button></bb-session-debug-modal-button>
  </div>
  <button name="modal-footer-button-primary"
          ng-click="$parent.$dismiss()"
          class="button js-primary-button"
          analytics-id="components.services.error-modal.dismiss"
