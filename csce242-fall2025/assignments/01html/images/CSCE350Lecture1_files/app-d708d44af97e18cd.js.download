         name="square-toggle-name-{{ ::squareToggle.radioGroupName }}"
         type="radio"
         value="{{ ::oneViewValue }}"
         aria-controls="{{ ::oneAriaControls }}"
         ng-click="squareToggle.handleClick($event)"
         ng-keyup="squareToggle.handleKeyUp($event)"
         enhanced-tooltip="true"
         tooltip-template="{{ ::oneTooltipTemplate }}"
         tooltip-scope="oneTooltipScope()"
         tooltip-position="bottom"
         tooltip-disable-on-mouse-over="true"
         analytics-id="{{analyticsIdTagPrefix}}.option1.input.radio">
  <label class="toggle-label input label-one js-label-{{oneIconClass}}"
         for="square-toggle-option-one-{{ ::squareToggle.oneControlId }}">
    <bb-svg-icon size="custom" icon="{{oneIconClass}}"></bb-svg-icon>
    <span class="sr-only" bb-translate>{{ ::oneAriaLabel }}</span>
  </label>
  <input class="toggle-input input-two"
         ng-checked="property === twoViewValue"
         aria-checked="{{property === twoViewValue}}"
         id="square-toggle-option-two-{{ ::squareToggle.twoControlId }}"
         name="square-toggle-name-{{ ::squareToggle.radioGroupName }}"
         type="radio"
         value="{{ ::twoViewValue }}"
         aria-controls="{{ ::twoAriaControls }}"
         ng-click="squareToggle.handleClick($event)"
         ng-keyup="squareToggle.handleKeyUp($event)"
         enhanced-tooltip="true"
         tooltip-template="{{ ::twoTooltipTemplate }}"
         tooltip-scope="twoTooltipScope()"
         tooltip-position="bottom"
         tooltip-disable-on-mouse-over="true"
         analytics-id="{{analyticsIdTagPrefix}}.option2.input.radio">
  <label class="toggle-label input label-two js-label-{{twoIconClass}}"
         for="square-toggle-option-two-{{ ::squareToggle.twoControlId }}">
    <bb-svg-icon size="custom" icon="{{twoIconClass}}"></bb-svg-icon>
    <span class="sr-only" bb-translate>{{ ::twoAriaLabel }}</span>
  </label>
  <a href="javascript:void(0);" class="button" role="presentation" tabindex="-1"
     analytics-id="{{analyticsIdTagPrefix}}.presentation.link"></a>
</div>
