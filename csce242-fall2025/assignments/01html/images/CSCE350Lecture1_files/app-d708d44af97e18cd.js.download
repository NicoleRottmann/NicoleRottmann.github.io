<div id="grade-grid-container" class="grade-grid-container" ng-class="{'membership-loading': !gg.initialized}">
  <div class="overall-grade-setup grade-search-filter-panel student-column" ng-if="gg.showFilterCriteria">
      <bb-grade-grid-search-filter-reborn merged-courses="::gg.mergedCourses"></bb-grade-grid-search-filter-reborn>
  </div>

  <div id="grade-grid" bb-grid-reborn="gg.gridOptions"></div>
  <div class="overall-grade-setup text-center" ng-if="gg.isOverallPanelShown && gg.canViewOverallPanel">
    <bb-setup-overall-grade show-fixed-view="gg.canViewOverallPanel" course-id="course().id" setup-overall-grade-hide-message-callback="gg.setupOverallGradeHideMessageCallback()"></bb-setup-overall-grade>
  </div>
  <clear-grade-model show-dialog="gg.openDirectGradeClearModel"
    on-close-dialog="gg.closeClearGradePopup"
    on-confirm-clear-grade="gg.confirmClearGradePopup"
    analytics-id="components.directives.grade.grid.directGradeClearModel"
  />
</div>
`},885218:(e,t,a)=>{var n=a(371818),s=a(608205),r=new n({id:"icon-small-accommodation",use:"icon-small-accommodation-usage",viewBox:"0 0 16 16",content:'<symbol fill="none" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" id="icon-small-accommodation"><circle cx="8" cy="8" r="7" stroke-width="2" /><path d="M4 6l1 2 5-3M12 10l-1-2-5 3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></symbol>'});s.add(r),e.exports=r},887835:e=>{e.exports=`<div>
  <!-- Display a loading spinner if page is rendering -->
  <div class="telemetry-loading-anim" ng-if="telemetryPanelHeader.showSpinner">
    <div class="spinner bb-secondary-color-2"/>
  </div>
  <header class="panel-header simple-header">
    <div class="panel-titles-container">
      <div class="panel-sub-title">{{ ::course().name }}</div>
      <div class="black-header-contents">
        <button class="left-off-canvas-toggle menu-toggle standard-button dark-background"
                type="button"
                analytics-id="components.directives.telemetry.panel.menu.button">
          <bb-svg-icon size="small" icon="main-menu"></bb-svg-icon>
          <span class="sr-only" bb-translate>components.directives.telemetry.panel.menu</span>
        </button>
        <h1 class="panel-title" ng-if="::titleKey" bb-translate>{{::titleKey}}</h1>
        <h1 class="panel-title" ng-if="title">{{::title}}</h1>
        <!-- BUTTON 2 (displayed to the left of Button 1) -->
        <button ng-if="buttonTwoIcon" id="button-two"
                aria-haspopup="true"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonTwoAriaLabel,'title': buttonTwoTitle}"
                ng-click="buttonTwoCallback()"
                ng-class="{ 'active': mobileStudentListVisible }"
                analytics-id="components.directives.telemetry.panel.buttonwTwo.button">
          <i class="{{ ::buttonTwoIcon }}"></i>
          <span class="sr-only" bb-translate>buttonTwoTitle</span>
        </button>
        <!-- BUTTON 1 (displayed on the far right) -->
        <button ng-if="buttonOneIcon"
                id="button-one"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonOneAriaLabel,'title': buttonOneTitle}"
                ng-click="buttonOneCallback()"
                analytics-id="components.directives.telemetry.panel.buttonOne.button">
          <i class="{{ ::buttonOneIcon }}"></i>
          <span class="sr-only" bb-translate>buttonOneTitle</span>
        </button>
      </div>
    </div>
  </header>
</div>
