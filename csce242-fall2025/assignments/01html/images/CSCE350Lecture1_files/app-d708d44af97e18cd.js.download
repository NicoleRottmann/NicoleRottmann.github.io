          analytics-id-tag-prefix="course.outline.studentPreview.firstTimeConfirmation">
  <div name="modal-contents">
    <bb-svg-icon size="custom" icon="preview-user-avatar"></bb-svg-icon>
    <p id="first-time-info" bb-translate>
      {{::courseOrgTokenPrefix}}.studentPreview.firstTimeConfirmation
    </p>
  </div>
  <button name="modal-footer-button-primary"
          type="button"
          class="button js-discard-changes js-primary-button"
          ng-click="$parent.$close()"
          analytics-id="course.outline.studentPreview.firstTimeConfirmation.startPreview.button">
    <span bb-translate="components.services.studentPreview.startPreview"></span>
  </button>
  <button name="modal-footer-button-secondary"
          type="button"
          class="button button--secondary js-cancel-discard js-secondary-button"
          ng-click="$parent.$dismiss()"
          analytics-id="course.outline.studentPreview.cancel.button">
    <span bb-translate="components.services.studentPreview.cancel"></span>
  </button>
</bb-modal>
