:e=>{e.exports=`<div class="discussion-assignment">
  <button class="button-add-content js-show-add-options" data-show-add-options ng-click="addContentButton.toggleMenu()"
     ng-class="{hide: !(addContentButton.isButtonVisible || addContentButton.alwaysShow || addContentButton.isMenuVisible)}"
     aria-expanded="{{addContentButton.isMenuVisible}}" aria-controls="{{::'add-content-menu-' + addMenuId}}"
     aria-label="{{addContentButton.addButtonAriaLabel}}"
     ng-focus="addContentButton.showButton()" ng-blur="addContentButton.hideButton()"
     analytics-id="components.directives.add-content-button.assignment.button">
  </button>
  <!-- use ng-show to keep the element when close add buttons, make sure the upload directive handlers will not be lost -->
  <ul role="menu" class="element-list-add-menu outline-menu angular-animate"
      aria-expanded="{{addContentButton.isMenuVisible}}"
      ng-attr-id="{{'add-content-menu-' + addMenuId}}"
      ng-if="::addContentButton.isMenuVisible || undefined"
      ng-show="addContentButton.isMenuVisible">
    <li>
      <bb-file-upload
        url="/v1/files"
        data="{}"
        allow-multiple="true"
        monitor-leave="true"
        disable-drag="disableDrag && disableDrag()"
        target-div="{{'#' + fileListViewId}}"
        hide-transclude-during-upload="false"
        is-third-party-upload="false"
        disallow-folder-uploads="true"
        skip-zip-file-check="true"
        ignored-states="::ignoredStates()"
        position="positionBefore ? positionBefore() : positionAfter && positionAfter() + 1">
        <a href="javascript:void(0);"
           role="menuitem"
           bb-translate-attrs="{'aria-label':'course.content.buildContentArea.addFiles'}"
           ng-click="addContentButton.toggleMenu()"
           analytics-id="components.directives.add-content-button.assignment.fileUpload.link" >
          <bb-svg-icon size="small" icon="upload"></bb-svg-icon><span bb-translate analytics-id="course.content.buildContentArea.addFiles">course.content.buildContentArea.addFiles</span>
        </a>
      </bb-file-upload>
    </li>
    <li ng-if="!addContentButton.isMobile">
      <!-- Skip zip file check, assignment does not support unzip file(LRN-101238) -->
      <bb-file-upload allow-multiple="true" monitor-leave="true" is-third-party-upload="true"  hide-transclude-during-upload="false" skip-zip-file-check="true"
                      click-enabled="false" primary-key="fileListViewId" disable-drag="disableDrag && disableDrag()"
                      third-party-download-handler="addContentButton.downloadFile" target-div="{{'#' + fileListViewId}}"
                      position="positionBefore ? positionBefore() : positionAfter && positionAfter() + 1">
        <a href="javascript:void(0);"
           role="menuitem"
           primary-key="fileListViewId"
           is-flatten="false"
           attach-handler="attachHandler || addContentButton.defaultAttachHandler"
           ignored-states="::ignoredStates()"
           bb-translate-attrs="{'aria-label':'components.directives.add-content-button.aria-label.content.oneDrive'}"
           ng-click="addContentButton.toggleMenu()"
           analytics-id="components.directives.add-content-button.assignment.oneDrive.link">
          <div>
            <i class="icon-cloud"></i><span bb-translate>components.directives.add-content-button.oneDrive</span>
          </div>
        </a>
      </bb-file-upload>
    </li>
  </ul>
</div>
