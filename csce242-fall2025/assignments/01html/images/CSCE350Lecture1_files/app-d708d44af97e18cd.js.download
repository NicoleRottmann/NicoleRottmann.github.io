          modal-title-key="components.directives.fileUpload.disallowedFileTypeTitle"
          analytics-id-tag-prefix="components.directives.fileUpload">
  <div name="modal-contents">
    <p>
      <bb-translate>components.directives.fileUpload.disallowedFileTypeFull</bb-translate>
      <a href="{{::fileUpload.getMoreSupportURL()}}" target="_blank" rel="noopener noreferrer" analytics-id="components.directives.fileUpload.moreSupportedFiles"><bb-translate>components.directives.fileUpload.moreSupportedFiles</bb-translate></a>
    </p>
  </div>
  <div name="modal-footer" class="reveal-modal__footer-content reveal-modal__footer-content--gray">
    <div class="reveal-modal__footer-buttons">
      <span class="reveal-modal__footer-button-container">
        <button role="button" class="button js-primary-button" ng-click="fileUpload.modalCancelUpload()" analytics-id="components.directives.fileUpload.cancelUploadText">
          <bb-translate>components.directives.fileUpload.cancelUploadText</bb-translate>
        </button>
      </span>
      <span class="reveal-modal__footer-button-container" ng-if="fileUpload.validFiles.length > 0">
        <button role="button" class="button button--secondary js-secondary-button" ng-click="fileUpload.closeModal()" analytics-id="components.directives.fileUpload.uploadValidFiles.plural">
          <bb-translate translate-values="{count:fileUpload.validFiles.length}">components.directives.fileUpload.uploadValidFiles.plural</bb-translate>
        </button>
      </span>
      <span class="reveal-modal__footer-button-container" ng-if="fileUpload.forceReselectDisallowedFiles && fileUpload.forceReselectDisallowedFiles()">
        <button role="button" class="button button--secondary js-secondary-button" ng-click="fileUpload.closeModalAndChooseFiles()" analytics-id="components.directives.fileUpload.selectAnotherFile">
          <bb-translate>components.directives.fileUpload.selectAnotherFile</bb-translate>
        </button>
      </span>
    </div>
  </div>
</bb-modal>
