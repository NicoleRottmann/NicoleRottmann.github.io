  <div bb-tooltip enhanced-tooltip="true" data-tooltip-on-overflow-only="true" title="{{ ::item().data }}">
    <div class="stat-data"
         ng-attr-aria-label="{{ item().aria ? item().aria : undefined }}"
         data-ng-bind-html="::item().trusted"
