         modal-title-key="components.directives.fileUpload.maxSizeWarningTitle"
         analytics-id-tag-prefix="max-size-warning-modal"
         modal-aria-type="alertdialog"
         >
  <div class="files-content" name="modal-contents">
    <div ng-repeat="group in filesGroupedByUploadLimit track by $index">
      <p class="warning-message" bb-translate="{{fileUpload.getWarningMessage(group.fileSizeLimit)}}"
         translate-values="{maxFileSize: calculateSizeInMib(group.fileSizeLimit)}"></p>
      <ul class="files-info-list">
        <li ng-repeat="file in group.files">
          <p class="file-info">{{file.name}}</p>
        </li>
      </ul>
    </div>
    <p class="alternate-storage-info">
      <span ng-bind-html="::getAlternateStorageInfo()">
      </span>
      <span ng-if="shouldIncludeSupportLink" ng-bind-html="supportLink"></span>
    </p>
  </div>
  <button name="modal-footer-button-primary" class="button js-primary-button" ng-click="closeModal()" analytics-id="components.directives.fileUpload.maxSizeWarningPrimary">
      <bb-translate>components.directives.fileUpload.maxSizeWarningPrimary</bb-translate>
  </button>
</bb-modal>
