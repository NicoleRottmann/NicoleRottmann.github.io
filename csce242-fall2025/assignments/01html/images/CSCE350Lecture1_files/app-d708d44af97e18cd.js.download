<div class="filter-list-content">
  <div class="filter-panel-container">
    <div class="filter-panel-header">
      <div class="filter-panel-title-wrapper">
        <h3 class="filter-panel-title" bb-translate>components.directives.grade.filter-panel.title</h3>
        <button type="button"
          class="filter-panel-close-button"
          data-is-visible="true"
          bb-translate-attrs="{'aria-label': 'components.directives.grade.filter-panel.closeFilterPanel'}"
          ng-click="gradeGridSearchFilterReborn.closeFilterCriteria()"
          analytics-id="components.directives.grade.filterPanel.close.button"
        >
          <div>
            <bb-svg-icon size="small" icon="close"></bb-svg-icon>
          </div>
        </button>
      </div>
      <button class="filter-panel-clear-all is-disabled"
              ng-disabled= "!gradeGridSearchFilterReborn.getCheckedMergedCourse() > 0"
              ng-class="{'filter-panel-clear-all-active': gradeGridSearchFilterReborn.getCheckedMergedCourse() > 0}"
              ng-click="gradeGridSearchFilterReborn.clearAll()"
              analytics-id="components.directives.grade.filter-panel.clearAll"
              bb-translate>
              components.directives.grade.filter-panel.clearAll
      </button>
    </div>
    <!-- TODO Container(style protoType) for search-box, enable in furture
    <div class="filter-panel-block" id="keyword-block">
        <div class="filter-panel-block-header">
          <h4 class="filter-panel-block-title">Keyword Search</h4>
          <button type="button filter-panel-toggle-button">
            <bb-svg-icon size="small" icon="arrow-down"></bb-svg-icon>
          </button>
        </div>
        <div class="filter-panel-search-box">
            <bb-typeahead-search-box id="student-search-box"
                                     input-placeholder="components.directives.grade.search-box.placeholder"
                                     sr-empty-results="components.directives.grade.search-box.emptyResults"
                                     sr-results-found="components.directives.grade.search-box.resultsFound"
                                     sr-no-results-found="components.directives.grade.search-box.noResultsFound"
                                     sr-label="components.directives.grade.search-box.placeholder"
                                     clear-aria-label="components.directives.grade.search-box.clear"
                                     icon="search">
            </bb-typeahead-search-box>
        </div>
    </div>
    -->
    <div class="filter-panel-block" id="sources-block" ng-repeat="criteriaBlock in gradeGridSearchFilterReborn.criteriaBlocks ">
        <div class="filter-panel-block-header" id ={{::criteriaBlock.id}}>
            <h4 class="filter-panel-block-title" course-org-token-resolver bb-translate>components.directives.grade.filter-panel.mergedCourseTitle</h4>
            <button type="button" class="filter-panel-toggle-button"
                    ng-class="{'filter-panel-block-toggle-close': !criteriaBlock.expanded }"
                    ng-click="gradeGridSearchFilterReborn.collapseMergedCourse(criteriaBlock)"
                    aria-label="{{gradeGridSearchFilterReborn.getToggleButtonLabel(criteriaBlock)}}"
                    analytics-id="components.directives.grade.filterPanel.mergedCourse.collapse.button"
            >
            <bb-svg-icon size="small" icon="arrow-down"></bb-svg-icon>
            </button>
          </div>
        <div class="filter-panel-groups" ng-show="criteriaBlock.expanded">
          <div class="filter-panel-group">
            <div class="filter-panel-item" ng-repeat="criteriaDetail in criteriaBlock.criteriaDetails track by $index" >
