<div class="possible-wrapper" ng-mousedown="gradeGridCellEditorReborn.mousedown()" ng-if="!gradeGridCellEditorReborn.isSchemaTypeComplete() && !gradeGridCellEditorReborn.isTextColumn()">
  <span id="totalPoints" class="possible" bb-translate translate-values="{total: col.data.possible}">
      components.directives.grade.grade-input.points
  </span>
</div>

  <bb-grid-text-grade-input
      text-grade="gradeGridCellEditorReborn.getTextGrade"
      analytics-id="components.directives.grade.gradeGridCellEditorReborn.input.text"
      on-blur="gradeGridCellEditorReborn.onTextGradeBlur"
      on-change-grade="gradeGridCellEditorReborn.onTextGradeChange"
      ng-if="gradeGridCellEditorReborn.isTextColumn()"
      ng-keydown="gradeGridCellEditorReborn.onKeydown($event)"
  ></bb-grid-text-grade-input>

  <bb-complete-incomplete-grade-pill
      ng-keydown="gradeGridCellEditorReborn.onKeydown($event)"
      ng-if="gradeGridCellEditorReborn.isSchemaTypeComplete()"
      class="js-completeScore"
      grade-value="gradeGridCellEditorReborn.score"
      is-complete="gradeGridCellEditorReborn.isStatusComplete()"
      on-blur="gradeGridCellEditorReborn.onCompleteIncompleteBlur"
      total-points="col.data.possible"
      aria-complete-incomplete-label="gradeGridCellEditorReborn.getAriaLabel()"
      analytics-id="components.directives.grade.gradeGridCellEditorReborn.input.text"
      initial-has-focus="true"
